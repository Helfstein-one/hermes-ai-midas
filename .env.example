# hermes-ai-midas Environment Configuration
# Default mode is 100% offline and deterministic

# Application & Offline Mode
MIDAS_OFFLINE_MODE=1
MIDAS_TESTING=1
MIDAS_WEBHOOK_SECRET=midas-secret-token-2026
MIDAS_PORT=8000
MIDAS_HOST=0.0.0.0

# AWS & Emulation (LocalStack / Moto)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_midas_key
AWS_SECRET_ACCESS_KEY=mock_midas_secret
AWS_ENDPOINT_URL=http://localhost:4566
MOTO_ENDPOINT_URL=http://localhost:4566
AWS_CE_MOCK_URL=http://localhost:8010

# Git Provider (local | gitea | github)
GIT_PROVIDER=local
GITEA_URL=http://localhost:3000
GITEA_TOKEN=
GITHUB_TOKEN=

# Model Router Providers (Optional Free-Tier APIs)
# Leave empty for pure deterministic AST & offline fixture fallback
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# FinOps Thresholds
MIN_MONTHLY_SAVINGS_USD=20.0
