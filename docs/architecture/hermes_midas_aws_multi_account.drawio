        <!-- 3 Pillars inside Fargate -->
        <mxCell id="p_mcp" value="&lt;b&gt;FastMCP Server Suite&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#64748B&#39; size=&#39;1&#39;&gt;Cross-Account Telemetry&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&#39;text-align:left; font-size:10px;&#39;&gt;&lt;b&gt;• mcp_aws_ce.py&lt;/b&gt;&lt;br/&gt;  get_top_offenders()&lt;br/&gt;  Multi-account CE queries&lt;br/&gt;&lt;b&gt;• mcp_cloudwatch.py&lt;/b&gt;&lt;br/&gt;  Logs Insights via AssumeRole&lt;br/&gt;&lt;b&gt;• mcp_git.py&lt;/b&gt;&lt;br/&gt;  Cross-repo branch &amp;amp; PR&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="fargate_box">
          <mxGeometry x="15" y="60" width="225" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p_engine" value="&lt;b&gt;Deterministic Engines&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#16A34A&#39; size=&#39;1&#39;&gt;&lt;b&gt;ZERO HALLUCINATION&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&#39;text-align:left; font-size:10px;&#39;&gt;&lt;b&gt;• Static AST Inspector&lt;/b&gt;&lt;br/&gt;  Removes orphan actions&lt;br/&gt;  Injects F.broadcast()&lt;br/&gt;  Coalesce(16) small files&lt;br/&gt;  Replaces @udf Catalyst&lt;br/&gt;&lt;b&gt;• FinOps Calculator&lt;/b&gt;&lt;br/&gt;  Glue DPU ($0.44/h)&lt;br/&gt;  EMR vCPU/RAM &amp;amp; DBU&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="fargate_box">
          <mxGeometry x="250" y="60" width="230" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p_router" value="&lt;b&gt;Model Router &amp;amp; Dedup&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#64748B&#39; size=&#39;1&#39;&gt;Circuit Breaker &amp;amp; Gate&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&#39;text-align:left; font-size:10px;&#39;&gt;&lt;b&gt;• Multi-Tier Router&lt;/b&gt;&lt;br/&gt;  T1: Parsing (Gemini Flash)&lt;br/&gt;  T2: Brain (Hermes-3 70B)&lt;br/&gt;  T3: Code (Qwen2.5-Coder)&lt;br/&gt;&lt;b&gt;• DynamoDB Registry&lt;/b&gt;&lt;br/&gt;  Canonical SHA-256 state&lt;br/&gt;&lt;b&gt;• The Midas Touch PR&lt;/b&gt;&lt;br/&gt;  Unified diff + IaC patch&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="fargate_box">
